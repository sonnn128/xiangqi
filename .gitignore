# ==============================================================================
# Git Ignore - Xiangqi (Cờ Tướng) Monorepo
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dữ liệu Docker & Database (Data volumes & persistence)
# ------------------------------------------------------------------------------
/data/
data/
*.rdb
*.aof

# ------------------------------------------------------------------------------
# 2. Frontend / Node.js (React & Vite)
# ------------------------------------------------------------------------------
**/node_modules/
**/dist/
**/build/
**/.vite/
**/.cache/

# Package managers log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Backend / Java (Maven & Spring Boot)
# ------------------------------------------------------------------------------
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear

# Maven Wrapper & test resources exception
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ------------------------------------------------------------------------------
# 4. Môi trường & Khóa bảo mật (Environment & Secrets)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.keystore
*.jks

# ------------------------------------------------------------------------------
# 5. IDE & Trình soạn thảo (Editors & Tools)
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA / WebStorm
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ------------------------------------------------------------------------------
# 6. Nhật ký & Tệp tạm (Logs & Temporary)
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. Hệ điều hành (OS Artifacts)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory

